# Ungalil Oruvan Organic Commerce Platform
# Copy to .env.local and fill values for production / hosted Supabase.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_ENV=development

# Local session signing secret (required in local-auth mode)
AUTH_SECRET=dev-only-change-me-use-32-plus-chars!!

# --- Supabase (optional in Stage 1 local preview) ---
# When these are unset, the app uses the local file-backed store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stage 2 placeholders (do not use yet) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
N8N_WEBHOOK_SECRET=
