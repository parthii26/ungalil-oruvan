# Ungalil Oruvan Environment Variables
# Copy to .env.local for local development

# Session security
SESSION_SECRET=dev_session_secret_replace_in_production_min_32_chars

# Supabase (Optional — falls back to local data/db.json)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stage 2 — Razorpay (Payments)
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Stage 2 — Resend (Email Notifications)
# Get API key from https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@yourdomain.com
