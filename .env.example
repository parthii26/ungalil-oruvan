# Ungalil Oruvan Organic Commerce Platform
# Copy to .env.local and fill values for production / hosted Supabase.

# --- App & Vercel Settings ---
# For local dev: http://localhost:3000
# For Vercel production: https://your-project.vercel.app (or custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_ENV=development

# Session signing secret (minimum 32 characters)
AUTH_SECRET=dev-only-change-me-use-32-plus-chars!!

# --- Supabase Database & Storage ---
# Found in your Supabase project settings -> API:
# Project URL:
NEXT_PUBLIC_SUPABASE_URL=
# Project API Key (anon / public):
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service Role Key (server-only, bypasses RLS - keep secret):
SUPABASE_SERVICE_ROLE_KEY=

# --- Stage 2 placeholders (do not use yet) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
N8N_WEBHOOK_SECRET=
