# Ungalil Oruvar Environment Variables
# Copy to .env.local for local development

# Session & Auth Security
AUTH_SECRET=your_auth_secret_replace_in_production_min_32_chars
CRON_SECRET=your_cron_worker_secret_key

# Centralized Business & Contact Info (Optional overrides)
CONTACT_EMAIL=care@ungaliloruvar.com
CONTACT_PHONE=+91 94430 12345
WHATSAPP_NUMBER=+91 94430 12345
BUSINESS_ADDRESS="Tamil Nadu, India"
SUPPORT_HOURS="Mon – Sat: 9:00 AM – 6:00 PM IST"
BUSINESS_GSTIN=
BUSINESS_FSSAI=

# Supabase (Optional — falls back to local data/db.json)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (Online Payments)
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Resend (Email Notifications)
# Get API key from https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=care@ungaliloruvar.com
